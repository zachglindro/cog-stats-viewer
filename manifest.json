{
  "manifest_version": 3,
  "name": "Choice of Games Stats Modifier",
  "version": "1.0",
  "description": "Add a stats modifier panel to Choice of Games pages",
  "permissions": ["activeTab", "tabs", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.choiceofgames.com/*/",
        "*://www.choiceofgames.com/user-contributed/*/"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge/bridge.js", "modifier.html"],
      "matches": [
        "*://www.choiceofgames.com/*",
        "*://www.choiceofgames.com/user-contributed/*"
      ]
    }
  ]
}
